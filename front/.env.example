# Copy to .env.local and fill in. .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin used to build the links Supabase emails out (confirmation,
# magic link, password reset). Optional in development, where the request host
# is used instead; set it in production so the links do not depend on a proxy
# header. No trailing slash. Whatever you set here must also be allowed under
# Authentication > URL Configuration in the Supabase dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
